# Copy to .env and fill in. .env is git-ignored; never commit real keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
GROQ_API_KEY=
# Optional: second Groq key (from another Groq account), tried when the first is rate-limited
GROQ_API_KEY_2=
SESSION_SECRET=
# Public https address of the app. When set, the login cookie is https-only and HSTS is sent.
APP_URL=
# Job lookups + drafts + revisions per user per 24 hours (0 turns the limit off).
DAILY_AI_LIMIT=40
