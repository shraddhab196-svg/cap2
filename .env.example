# Copy to .env and fill in. .env is git-ignored; never commit real keys.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
GROQ_API_KEY=
# Optional: second Groq key (from another Groq account), tried when the first is rate-limited
GROQ_API_KEY_2=
# Optional: readers for company sites that block us or need JavaScript (Jina works without a key)
JINA_API_KEY=
FIRECRAWL_API_KEY=
SESSION_SECRET=
# Public https address of the app. When set, the login cookie is https-only and HSTS is sent.
APP_URL=
# Job lookups + drafts + revisions per user per 24 hours (0 turns the limit off).
DAILY_AI_LIMIT=40
# Total size of stored original files in MB; past it, originals aren't kept (text still is)
STORAGE_BUDGET_MB=800
